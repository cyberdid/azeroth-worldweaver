+    void SetTaskHuntTargets(std::vector<uint32> const& entries, uint32 mapId, uint32 zoneId, uint32 areaId)
+    {
+        taskHuntTargetCount.store(0, std::memory_order_release);
+        uint32 const count = static_cast<uint32>(std::min(entries.size(), taskHuntTargetEntries.size()));
