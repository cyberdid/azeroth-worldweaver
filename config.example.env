# Copy these values into the service environment; this file is not loaded automatically.
WOW_AGENT_SERVER_DIR=/path/to/azeroth-server
WOW_SERVER_CONFIG=/path/to/azeroth-server/etc/worldserver.conf
WOW_AGENT_TELEMETRY_DIR=/home/your-user/.local/state/azeroth-worldweaver
WOW_AGENT_WORKDIR=/path/to/your/workspace
WOW_AGENT_BOT_NAME=Codex
WOW_AGENT_OTHER_BOT=Claude
# Comma-separated exact in-game character names allowed to initiate tasks. Empty means deny all.
WOW_AGENT_AUTHORIZED_PLAYERS=
# Defaults to workspace-write. danger-full-access is intentionally opt-in.
WOW_AGENT_CODEX_SANDBOX=workspace-write
# Claude service overrides (run a second adapter instance with these values).
WOW_AGENT_CLAUDE_MODEL=
WOW_AGENT_CLAUDE_EFFORT=xhigh
# Local SOAP endpoint and path to a mode-0600 file containing username:password.
WOW_SOAP_URL=http://127.0.0.1:7878/
WOW_SOAP_CREDENTIAL_FILE=/path/to/private/claude-soap.cred
